{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "screenshot.config.ts",
    "scenarios.config.ts",
    "scenarios/**/*.ts",
    "tests/**/*.ts",
    "screenshots/**/*.ts",
    "support/**/*.ts"
  ]
}
