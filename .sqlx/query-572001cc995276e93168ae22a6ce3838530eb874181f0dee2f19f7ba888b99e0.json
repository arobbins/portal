{
  "db_name": "PostgreSQL",
  "query": "SELECT o.id AS connection_id, o.user_id, o.scopes AS \"scopes: Vec<ApiScope>\", c.name, o.return_host FROM oauth_tokens t JOIN oauth_connections o ON o.id = t.connection_id JOIN oauth_clients c ON c.id = o.client_id WHERE t.token_hash = $1 AND t.kind = 'access' AND t.expires_at > $2",
