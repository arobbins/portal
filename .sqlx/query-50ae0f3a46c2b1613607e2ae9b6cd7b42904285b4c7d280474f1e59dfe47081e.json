  "query": "WITH used AS (DELETE FROM oauth_requests WHERE code_hash = $1 AND status = 'approved' RETURNING connection_id, client_id, redirect_uri, code_challenge, acted_at) SELECT used.connection_id AS \"connection_id!\", c.client_id, used.redirect_uri, used.code_challenge, used.acted_at FROM used JOIN oauth_clients c ON c.id = used.client_id",
