  "query": "SELECT u.id, u.name, u.email, u.password, u.role AS \"role: Role\", u.verified_at, u.session_version, u.webauthn_id, u.public_id, u.disabled_at, u.admin_granted_at, d.last_seen_at\n        FROM user_devices d JOIN users u ON u.id = d.user_id\n        WHERE d.public_id = $1 AND d.user_id = $2 AND d.session_version = u.session_version AND u.disabled_at IS NULL",
