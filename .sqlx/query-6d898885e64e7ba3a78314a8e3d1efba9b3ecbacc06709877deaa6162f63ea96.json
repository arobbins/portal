  "query": "SELECT l.admin_email, l.action AS \"action: AdminLogAction\", l.target_public_id, l.target_email,\n            EXISTS (SELECT 1 FROM users u WHERE u.public_id = l.target_public_id) AS \"target_exists!\",\n            l.created_at\n        FROM admin_log l\n        ORDER BY l.created_at DESC, l.id DESC\n        LIMIT $1",
